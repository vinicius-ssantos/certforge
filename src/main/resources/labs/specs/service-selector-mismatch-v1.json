{
  "labId": "service-selector-mismatch-v1",
  "image": {
    "ref": "docker.io/library/busybox@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662"
  },
  "fixture": {
    "path": "service-selector-mismatch-v1"
  },
  "objective": {
    "title": "Fix a Service selector",
    "description": "The web-backend Service has no endpoints. Correct spec.selector so it matches the Deployment's Pod labels, and reapply it."
  },
  "allowedCommands": ["kubectl", "vi", "nano", "cat", "ls"],
  "sandbox": {
    "vcpus": 1,
    "timeoutSeconds": 900,
    "persistent": false
  },
  "network": {
    "egress": "none"
  },
  "filesystem": {
    "writableScratchMiB": 64
  },
  "evaluation": {
    "type": "deterministic-probe",
    "checks": [
      {
        "description": "The web-backend Service has a serving endpoint",
        "probe": "kubectl get endpointslice -l kubernetes.io/service-name=web-backend -o jsonpath='{.items[0].endpoints[0].conditions.serving}'"
      }
    ]
  }
}
