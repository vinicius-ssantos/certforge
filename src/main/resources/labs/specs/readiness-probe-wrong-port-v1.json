{
  "labId": "readiness-probe-wrong-port-v1",
  "isolation": "kata",
  "image": {
    "ref": "docker.io/library/busybox@sha256:73aaf090f3d85aa34ee199857f03fa3a95c8ede2ffd4cc2cdb5b94e566b11662"
  },
  "fixture": {
    "path": "readiness-probe-wrong-port-v1"
  },
  "objective": {
    "title": "Fix a readiness probe",
    "description": "The web Deployment's Pods never become Ready. Edit the manifest so the readinessProbe actually reaches the container's port, and reapply it."
  },
  "allowedCommands": ["kubectl", "vi", "nano", "cat", "ls"],
  "limits": {
    "wallClockSeconds": 900,
    "memoryMiB": 512,
    "cpuMillicores": 500,
    "diskMiB": 256,
    "processCount": 64
  },
  "network": {
    "egress": "none"
  },
  "filesystem": {
    "writableScratchMiB": 64
  },
  "evaluation": {
    "type": "deterministic-probe",
    "checks": [
      {
        "description": "The web Pod reports Ready",
        "probe": "kubectl get pod -l app=web -o jsonpath='{.items[0].status.conditions[?(@.type==\"Ready\")].status}'"
      }
    ]
  }
}
